---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search — StackScout" description="Search all StackScout engineering articles." active="search">
  <div class="section-label">SEARCH</div>
  <div id="search" data-pagefind-ignore></div>
  <noscript><p>Search needs JavaScript. Browse the <a href="/posts/">archive</a> instead.</p></noscript>
  <p id="search-dev-note" hidden>
    Search index is generated by <code>npm run build</code> (Pagefind). Run <code>npm run build &amp;&amp; npm run preview</code> to test it.
  </p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    if (window.PagefindUI) {
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
      new URLSearchParams(location.search).get('q') && document.querySelector('#search input')?.focus();
    } else {
      document.getElementById('search-dev-note').hidden = false;
    }
  </script>
</BaseLayout>
